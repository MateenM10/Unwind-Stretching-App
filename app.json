{
  "expo": {
    "name": "Unwind",
    "slug": "unwind",
    "description": "A calm, minimal stretching companion — guided sessions, streak tracking, and voice-cued breathing, all designed to help you ease the tension out of your day.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/unwind-icon.png",
    "scheme": "unwind",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mateenm10.unwind"
    },
    "android": {
      "package": "com.mateenm10.unwind",
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/images/unwind-android-icon-foreground.png",
        "backgroundImage": "./assets/images/unwind-android-icon-background.png",
        "monochromeImage": "./assets/images/unwind-android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/unwind-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/unwind-splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2",
          "dark": {
            "backgroundColor": "#2C2416"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}